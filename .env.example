# ══════════════════════════════════════════════════════════════════════════
# PARA QUÉ SIRVE ESTE ARCHIVO
#
# Es la PLANTILLA de variables de entorno: dice QUÉ necesita el proyecto, no
# cuánto vale. Se copia a `.env.local` y ahí se rellenan los valores.
#
# ⚠️ ESTE ARCHIVO SÍ VA A GIT. `.env.local` NO — lo tapa el `.env*` del
# `.gitignore`, línea 8.
#
# ⚠️ REGLA: acá no se pega NINGÚN secreto. Una variable secreta se deja
# VACÍA y con un comentario que diga de dónde sacarla. Lo único que puede
# tener valor son datos que ya son públicos —una dirección de mail que está
# impresa en el sitio, la URL del dominio—.
#
# Si alguna vez este archivo termina con una key adentro, no alcanza con
# borrarla en un commit nuevo: queda en el historial y hay que ROTAR la key.
# ══════════════════════════════════════════════════════════════════════════

# ── Resend ────────────────────────────────────────────────────────────────
# La API key ya existe como SHARED ENV VAR en Vercel: no se pega acá ni se
# commitea. En local, copiá este archivo a `.env.local` y pegá la key ahí.
RESEND_API_KEY=

# Remitente. Tiene que ser un dominio VERIFICADO en Resend; si no, Resend
# rechaza el envío.
#
# ⚠️ ES @restoexp.com Y NO @eatdrinkparadise.com. restoexp.com es el ÚNICO
# dominio verificado en la cuenta de Resend de la casa (lo mismo usan juanitos
# y yava). Hasta el 2026-09-23 esto decía events@eatdrinkparadise.com, que
# Resend habría rechazado en el primer envío. Quien recibe igual contesta a la
# persona correcta: cada mail sale con `replyTo` = el mail de quien escribió.
RESEND_FROM="Rooftop at Riverside Website <rooftop@restoexp.com>"

# ── A dónde llega cada formulario ─────────────────────────────────────────
# Una o varias direcciones separadas por coma. Si una falta, `lib/inboxes.ts`
# cae al buzón público de `lib/brand.ts`, así que nunca queda sin destino.
# Los valores son los buzones que publica hoy eatdrinkparadise.com (ver la
# nota de `lib/inboxes.ts`). No son secretos: están impresos en el sitio.
#
#   /contact (todo salvo «Working here»)
MAIL_TO_CONTACT=info@eatdrinkparadise.com
#   /events, la consulta de evento privado
MAIL_TO_EVENTS=events@eatdrinkparadise.com
#   /join-us carril de trabajo, y /contact con «Working here»
MAIL_TO_CAREERS=hiring@eatdrinkparadise.com
#   /market, la solicitud de puesto
MAIL_TO_MARKET=info@eatdrinkparadise.com
#   /join-us carril de artistas
MAIL_TO_BOOKING=info@eatdrinkparadise.com

# ── Newsletter ────────────────────────────────────────────────────────────
# ⚠️ PENDIENTE BLOQUEANTE: esta URL NO EXISTE TODAVÍA. Sin ella, el formulario
# del pre-footer valida y responde un error visible, pero el alta NO se
# guarda en ninguna parte. El paso a paso para crear la planilla y publicar
# el Apps Script está en `docs/pedido-al-cliente.md`.
#
# ⚠️ NO es un secreto de los caros —es una URL de Apps Script publicada, sin
# token— pero igual no se pega acá: quien tenga la URL puede escribir filas
# en la planilla del cliente.
#
# ⚠️ Y NO hay `NEWSLETTER_INBOX`. Estaba declarada de una versión anterior que
# mandaba un mail por alta con Resend. Un mail por alta no es una lista:
# alguien tenía que copiar las direcciones a mano antes de poder enviar nada.
NEWSLETTER_SHEETS_WEBHOOK_URL=

# ── Contenido ─────────────────────────────────────────────────────────────
# No hay base de datos. Contacto, horarios, menús, eventos, vacantes y blog
# viven en los JSON de `src/content/` (ver README). No hace falta ninguna
# variable para leerlos.
