# ══════════════════════════════════════════════════════════════════════════
# PARA QUÉ SIRVE ESTE ARCHIVO
#
# Es la PLANTILLA de variables de entorno: dice QUÉ necesita el proyecto, no
# cuánto vale. Se copia a `.env.local` y ahí se rellenan los valores.
#
# ⚠️ ESTE ARCHIVO SÍ VA A GIT. `.env.local` NO — lo tapa el `.env*` del
# `.gitignore`, línea 8.
#
# ⚠️ REGLA: acá no se pega NINGÚN secreto. Una variable secreta se deja
# VACÍA y con un comentario que diga de dónde sacarla. Lo único que puede
# tener valor son datos que ya son públicos —una dirección de mail que está
# impresa en el sitio, la URL del dominio—.
#
# Si alguna vez este archivo termina con una key adentro, no alcanza con
# borrarla en un commit nuevo: queda en el historial y hay que ROTAR la key.
# ══════════════════════════════════════════════════════════════════════════

# ── Resend ────────────────────────────────────────────────────────────────
# La API key ya existe como SHARED ENV VAR en Vercel: no se pega acá ni se
# commitea. En local, copiá este archivo a `.env.local` y pegá la key ahí.
RESEND_API_KEY=

# Remitente. Tiene que ser un dominio VERIFICADO en Resend; si no, Resend
# rechaza el envío. Mientras el dominio del cliente no esté verificado se puede
# usar el sandbox de Resend (onboarding@resend.dev), que sólo entrega a la
# casilla dueña de la cuenta.
RESEND_FROM="Rooftop at Riverside <events@eatdrinkparadise.com>"

# A dónde llegan las consultas de eventos.
EVENTS_INBOX=events@eatdrinkparadise.com

# ── Newsletter ────────────────────────────────────────────────────────────
# ⚠️ PENDIENTE BLOQUEANTE: esta URL NO EXISTE TODAVÍA. Sin ella, el formulario
# del pre-footer valida y responde un error visible, pero el alta NO se
# guarda en ninguna parte. El paso a paso para crear la planilla y publicar
# el Apps Script está en `docs/pedido-al-cliente.md`.
#
# ⚠️ NO es un secreto de los caros —es una URL de Apps Script publicada, sin
# token— pero igual no se pega acá: quien tenga la URL puede escribir filas
# en la planilla del cliente.
#
# ⚠️ Y NO hay `NEWSLETTER_INBOX`. Estaba declarada de una versión anterior que
# mandaba un mail por alta con Resend. Un mail por alta no es una lista:
# alguien tenía que copiar las direcciones a mano antes de poder enviar nada.
NEWSLETTER_SHEETS_WEBHOOK_URL=

# ── Sitio ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://rooftopatriverside.com

# ── RestoExp / Supabase ───────────────────────────────────────────────────
# La instancia de Supabase detrás del dashboard. Es COMPARTIDA por todos los
# sitios de la casa; lo que separa a un cliente de otro es el `RESTAURANT_ID`.
#
# ⚠️ ESTAS TRES NO ALCANZAN PARA LEER LOS EVENTOS, y conviene saberlo antes
# de perder una tarde. Probado el 2026-09-11 con la anon key de Rooftop:
#
#     GET /rest/v1/            → 0 tablas expuestas
#     GET /rest/v1/events      → PGRST205, la tabla no existe en el esquema
#     GET /storage/v1/bucket   → []
#     GET app.restoexp.com/api → 401
#
# O sea: la anon key autentica contra la instancia pero no tiene permiso
# sobre nada. Los eventos NO se sirven por PostgREST — viven detrás de la API
# del dashboard, que exige sesión. Ver `scripts/sync-events.mjs`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_RESTAURANT_ID=

# La cookie de sesión de app.restoexp.com, que es lo ÚNICO que hoy permite
# leer los eventos (`npm run sync:events`). Se saca del navegador con sesión
# iniciada: DevTools → Application → Cookies. Vence, así que hay que
# renovarla cada tanto.
#
# ⚠️ NO pegar acá una `SUPABASE_SERVICE_ROLE_KEY`. Esa llave saltea el
# row-level security de una instancia MULTI-CLIENTE: en este repo daría
# acceso administrador a los datos de todos los demás restaurantes.
RESTOEXP_COOKIE=
