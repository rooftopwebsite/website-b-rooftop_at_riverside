# Capturas de referencia locales (no forman parte del sitio)
/n*.png
/ref*.png

# Fuentes originales (.otf/.ttf). Las que usa el sitio ya están convertidas en
# src/app/fonts/; el script que las convertía (install-fonts.mjs) no existe más.
# Se mudaron a _interno/fuentes/ el 2026-09-23; la regla queda por si vuelven.
public/fonts/_drop/

# Originales de multimedia del cliente (681 MB). Entrada de `npm run media`;
# lo que se versiona son los derivados de public/images/venue y public/videos.
public/multimedia/

# Capturas de trabajo del rediseño. Los ENTREGABLES —baseline/, after/,
# COMPARAR-*.png, specimen-*.png— sí se versionan; estas son intermedias y se
# regeneran con los scripts de design-audit/.
design-audit/fase*/
design-audit/HOJA-*.png
design-audit/tmp/
design-audit/specimen.html

# ─────────────────────────────────────────────────────────────────────────
# MATERIAL INTERNO DEL CLIENTE. NO SE SUBE NUNCA.
# Acá van los PDF de brief, el brand book, el moodboard y cualquier archivo
# con datos del cliente (emails, teléfonos, fees, presupuestos). Regla de
# Camila, 2026-09-11: si es del cliente o es nuestro material de trabajo
# interno, vive acá y no entra a git jamás.
# ─────────────────────────────────────────────────────────────────────────
/_interno/

# Volcado crudo del sitio Wix vigente. Material de referencia, NO se publica
# ni se versiona: es el ORIGINAL, y adentro van precios de eventos del cliente
# y un mail interno (ver _interno/LEEME.md y docs/INVARIANTES.md §5b). Lo que
# se versiona es el derivado: el dato transcrito en content/*.ts.
# Se regenera con design-audit/tmp/scrape-wix.mjs
src/content/_source/

# Log del `next dev` cuando se lo corre a un archivo. Artefacto local.
dev-server.log

# Basura del sistema operativo. `desktop.ini` es la personalización de carpeta
# de Windows: se entró por error en 5e34c6e y se sacó el 2026-09-23.
desktop.ini
Thumbs.db
